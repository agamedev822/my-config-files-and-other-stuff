// the zed settings file!
// ----------------------
// here you can customize
// zed with json and
// stuff!
// ----------------------
{
  // this is the start of the settings.json!
  // those are if vim mode is on or not and the terminal!
  "accessible_mode": false,
  "git": {
    "disable_git": false
  },
  "proxy": "",
  "autosave": "on_focus_change",
  "title_bar": {
    "show_menus": true,
    "show_branch_status_icon": true
  },
  "status_bar": {
    "show_active_file": true,
    "line_endings_button": true
  },
  "git_panel": {
    "dock": "left"
  },
  "minimum_contrast_for_highlights": 52.0,
  "text_rendering_mode": "subpixel",
  "buffer_font_weight": 900.0,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "icon_theme": {
    "mode": "system",
    "light": "Colored Zed Icons Theme Dark",
    "dark": "Colored Zed Icons Theme Light"
  },
  "vim_mode": false,
  "terminal": {
    "minimum_contrast": 0,
    // i use powershell btw
    "shell": {
      "program": "pwsh.exe"
    }
  },

  // you cant understand how mutch i like JetBrains Nerd Font
  "ui_font_family": "JetBrainsMono Nerd Font",
  // NO AI
  "disable_ai": true,
  // i made it to the left bc im more used to VScode ;-;
  "project_panel": {
    "dock": "left"
  },
  // i hated that thing when i cant use my cool ass extensions in a new file or folder
  "session": {
    "trust_all_worktrees": true
  },
  // zed
  "base_keymap": "Zed",
  // font stuff
  "ui_font_size": 14,
  "buffer_font_size": 14.0,
  "theme": {
    // theme stuff
    "mode": "dark",
    "light": "Catppuccin Mocha",
    "dark": "Everforest Dark Medium (blur)",
  },
  // and lastly the programing languages stuff
  "languages": {
    "Lua": {
      "semantic_tokens": "combined"
    }
  }
}
